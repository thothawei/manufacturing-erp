+namespace Erp.Application.Ml;
+
+/// 一筆模擬的客訴紀錄：文本 + 多標籤（一則客訴可能同時命中多個分類）。
+///
+/// 手動覆寫 Equals/GetHashCode：record 預設的欄位比較對 Labels（清單型別）是參考相等，
+/// 兩份內容一樣但是不同 List 實例的資料會被判定「不相等」——這會讓「同一個種子產生
+/// 完全一樣的資料」這條可重現性測試失去意義。改成逐一比較清單內容。
+public sealed record ComplaintRecord(string ComplaintNo, string Text, IReadOnlyList<string> Labels)
+{
+    public bool Equals(ComplaintRecord? other) =>
+        other is not null
+        && ComplaintNo == other.ComplaintNo
+        && Text == other.Text
+        && Labels.SequenceEqual(other.Labels);
+
+    public override int GetHashCode() => HashCode.Combine(ComplaintNo, Text, Labels.Count);
+}
+
+/// 產生訓練用的模擬客訴文本，多標籤分類（品質-外觀／品質-功能／交期／包裝／服務態度／其他）。
+///
+/// **這是模擬資料，不是真實客訴紀錄。** 理由與 <see cref="HistoricalWorkOrderGenerator"/> 相同：
+/// 這裡示範的是「資料生成 → 清理 → 訓練 → 評估」整條鏈路走得通，不是宣稱模型對真實客訴有效。
+///
+/// 與既有 RAG 故事世界共用同一批背景設定（見 <c>DemoCorpus</c> 的兩份客訴紀錄）：
+/// TV-100／MON-200 機種、PANEL-01 面板、SUP-008 供應商、面板色偏、訊號線接觸不良、
+/// 貼合機（EQ-LAM-01）、自動鎖螺絲機（EQ-SCR-02）。合成客訴的用詞刻意對齊這些既有設定，
+/// 讓 RAG 示範與這個分類模型看起來像同一家工廠的真實資料，而不是兩套互不相干的假資料。
+///
+/// 為什麼寫在 C# 而不是 Python：與工單延遲生成器同一個理由 —— 標籤定義只能有一份。
+/// 這裡的六個標籤字串（品質-外觀／品質-功能／交期／包裝／服務態度／其他）就是唯一真相，
+/// 訓練腳本與線上推論都照抄 <see cref="AllLabels"/>，不會有兩邊標籤集合對不齊的問題。
+///
+/// 標籤生成規則（多標籤）：
+///   1. 先以加權隨機選出「主要標籤」（<see cref="PrimaryWeights"/>），
+///      權重刻意做成長尾：服務態度約 4%、包裝約 8%，其餘較多。
+///      長尾是這個模組的重點 —— 全部均勻分布的話，模型全猜多數類也會有高準確率，
+///      macro-F1 才是唯一能戳穿這種假象的指標。
+///   2. 25% 機率依「主要標籤 → 常見共伴標籤」的對照表加一個次要標籤
+///      （例如交期延遲常常伴隨服務態度抱怨，外觀瑕疵常常伴隨功能異常），
+///      這是多標籤樣本的主要來源，也讓標籤共現符合現實直覺，不是隨機亂配。
+///   3. 5% 機率再加第三個標籤（少見但不是不可能：一次客訴同時踩到三個問題）。
+///
+/// 刻意注入的雜訊，每一項都對應一個現實情境：
+///   - 同義改寫：每個標籤準備多組句式，隨機挑選，避免同一標籤永遠長同一個樣子。
+///   - 錯別字/口語（<see cref="ApplyTypo"/>）：現場填單用注音輸入法連點造成的疊字，
+///     以及「的/得」「在/再」「面板/面版」這類常見同音誤植。
+///   - 5% 標籤雜訊：客服人工標註時漏標或多標一個分類 —— 標註品質本身就不是完美的，
+///     模型評估如果假設標籤全對，macro-F1 會虛高於真實部署後的表現。
+///   - 5% 極短文本：像「東西壞了」這種沒有資訊量的短句 —— 標籤其實是客服依電話
+///     談話內容另外判定的，文本本身推不出標籤。這一批樣本刻意留著，逼分類器
+///     承認「這幾筆真的學不到」，而不是把資料洗到只剩好學的樣本。
+///
+/// 亂數種子固定，所以同一個 seed 產生的資料完全一樣 —— clone 下來能訓練出同一個模型。
+public sealed class ComplaintGenerator(int seed = 20260916)
+{

@@ -0,0 +1,135 @@
+using Erp.Application.Ml;
+
+namespace Erp.Application.Tests;
+
+/// 客訴多標籤合成資料生成器。
+///
+/// 驗的不是「文本像不像真的客訴」（那沒有客觀標準），而是四件會讓後續訓練與評估
+/// 整個失去意義的事：可重現、長尾類別真的稀少但不是零、標籤雜訊真的加進去了、
+/// 文本沒有重複到模型靠記憶就能答對。
+public class ComplaintGeneratorTests
+{
+    [Fact]
+    public void 同一個種子產生完全一樣的資料()
+    {
+        // 「評審 clone 下來能訓練出同一個模型」的前提，與工單延遲生成器同理
+        var first = new ComplaintGenerator(42).Generate(300);
+        var second = new ComplaintGenerator(42).Generate(300);
+
+        Assert.Equal(first, second);
+    }
+
+    [Fact]
+    public void 不同種子產生不同資料()
+    {
+        var first = new ComplaintGenerator(1).Generate(300);
+        var second = new ComplaintGenerator(2).Generate(300);
+
+        Assert.NotEqual(first, second);
+    }
+
+    [Fact]
+    public void 長尾類別稀少但不是零()
+    {
+        // 服務態度約 4%、包裝約 8%，刻意做出長尾；主力類別（品質-功能）要明顯多於它們，
+        // 否則全部均勻分布，macro-F1 就測不出「模型在長尾類別學得好不好」這件事
+        var records = new ComplaintGenerator().Generate(1500);
+
+        var attitude = records.Count(r => r.Labels.Contains(ComplaintGenerator.LabelAttitude));
+        var packaging = records.Count(r => r.Labels.Contains(ComplaintGenerator.LabelPackaging));
+        var function = records.Count(r => r.Labels.Contains(ComplaintGenerator.LabelFunction));
+
+        var attitudeRate = attitude / (double)records.Count;
+        var packagingRate = packaging / (double)records.Count;
+
+        Assert.InRange(attitudeRate, 0.01, 0.08);
+        Assert.InRange(packagingRate, 0.03, 0.15);
+        Assert.True(attitude > 0, "長尾類別不能是零筆，否則模型連學的機會都沒有");
+        Assert.True(packaging > 0);
+        Assert.True(attitude < function, "長尾類別的樣本數必須明顯少於主力類別（品質-功能）");
+        Assert.True(packaging < function);
+    }
+
+    [Fact]
+    public void 多標籤樣本確實存在()
+    {
+        // 一則客訴可能同時命中多個分類，這是多標籤分類問題的前提；
+        // 如果生成器其實每筆只給一個標籤，訓練腳本裡的多標籤損失函數就是在處理不存在的情境
+        var records = new ComplaintGenerator().Generate(1500);
+        var multiLabel = records.Count(r => r.Labels.Count > 1);
+        var rate = multiLabel / (double)records.Count;
+
+        Assert.True(multiLabel > 0, "多標籤樣本不能是零筆");
+        Assert.InRange(rate, 0.15, 0.4);
+    }
+
+    [Fact]
+    public void 標籤雜訊比例在設計值附近()
+    {
+        // 「其他」在設計上不會透過主要／次要／第三標籤機制跟任何其他標籤同時出現
+        // （PickLabels 的共伴表與第三標籤候選都明確排除「其他」）。
+        // 所以「其他」跟別的標籤一起出現，只可能來自 5% 標籤雜訊裡的「多標」分支。
+        // 用這個訊號回推雜訊比例落在設計值附近 —— 樣本數拉大到兩萬筆讓比例估計穩定一點。
+        var records = new ComplaintGenerator(777).Generate(20000);
+        var contaminated = records.Count(r =>
+            r.Labels.Contains(ComplaintGenerator.LabelOther) && r.Labels.Count > 1);
+        var rate = contaminated / (double)records.Count;
+
+        Assert.InRange(rate, 0.003, 0.03);
+    }
+
+    [Fact]
+    public void 文本重複率低於門檻()
+    {
+        // 同一標籤組合下如果文本長得一模一樣，模型靠記憶字串就能答對，
+        // macro-F1 會虛高，測不出真正的語意分類能力
+        var records = new ComplaintGenerator().Generate(1500);
+        var distinctCount = records.Select(r => r.Text).Distinct().Count();
+        var duplicateRate = 1 - (distinctCount / (double)records.Count);
+
+        Assert.True(duplicateRate < 0.15, $"文本重複率 {duplicateRate:P1} 超過門檻");
+    }
+
+    [Fact]
+    public void 每個標籤都有對應到明確的字串常數()
+    {
+        // 標籤集合的唯一真相是 AllLabels，訓練腳本與線上推論都照抄這份清單
+        Assert.Equal(6, ComplaintGenerator.AllLabels.Count);
+        Assert.Contains(ComplaintGenerator.LabelAppearance, ComplaintGenerator.AllLabels);
+        Assert.Contains(ComplaintGenerator.LabelFunction, ComplaintGenerator.AllLabels);
+        Assert.Contains(ComplaintGenerator.LabelDelivery, ComplaintGenerator.AllLabels);
+        Assert.Contains(ComplaintGenerator.LabelPackaging, ComplaintGenerator.AllLabels);
+        Assert.Contains(ComplaintGenerator.LabelAttitude, ComplaintGenerator.AllLabels);
+        Assert.Contains(ComplaintGenerator.LabelOther, ComplaintGenerator.AllLabels);
+    }
+
+    [Fact]
+    public void CSV欄位是text與labels而且標籤用直線分隔()
+    {
+        // 用夠大的筆數確保至少有一筆多標籤樣本，不依賴只抽 3 筆時的運氣
+        var records = new ComplaintGenerator().Generate(200);
+        var csv = ComplaintGenerator.ToCsv(records);
+        var lines = csv.Split('\n');
+
+        Assert.Equal("text,labels", lines[0]);
+        Assert.Contains(records, r => r.Labels.Count > 1);
+
+        var multiLabelRecord = records.First(r => r.Labels.Count > 1);
+        Assert.Contains(string.Join("|", multiLabelRecord.Labels), csv);
+    }
+
+    [Fact]
+    public void CSV正確處理文本裡的逗號與引號()
+    {
+        var record = new ComplaintRecord(
+            "CS-00001",
+            "面板有,裂痕\"還有\"色偏",
+            [ComplaintGenerator.LabelAppearance, ComplaintGenerator.LabelFunction]);
+
+        var csv = ComplaintGenerator.ToCsv([record]);
+        var lines = csv.Split('\n');
+
+        Assert.Equal("text,labels", lines[0]);
+        Assert.Equal("\"面板有,裂痕\"\"還有\"\"色偏\",品質-外觀|品質-功能", lines[1]);
+    }
+}

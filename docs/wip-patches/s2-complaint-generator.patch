+        ]
+    };
+
+    /// 通用細節句，跟標籤無關，純粹增加文本多樣性 —— 現實中的客訴常常會多補一句
+    /// 抱怨的來龍去脈或情緒，這句話跟分類無關，模型不該把它當成訊號。
+    private static readonly string[] DetailClauses =
+    [
+        "已經是第二次發生類似的狀況了",
+        "身邊朋友知道了都說不敢買這牌子",
+        "訂購前特地查過評價才下單，結果還是踩雷",
+        "當初就是看中這個型號才特地買的，很失望",
+        "已經跟客服反應過，但到現在都沒有下文",
+        "本來想推薦給家人，現在完全打消念頭",
+        "第一次遇到這種狀況，不知道是不是個案"
+    ];
+
+    /// 5% 極短文本的候選池。刻意準備夠多組（並可另外接上機型前綴），
+    /// 避免這批「沒資訊量」的樣本本身又重複到失真。
+    private static readonly string[] ShortTexts =
+    [
+        "東西壞了", "不能用", "有問題", "品質很差", "故障了", "壞掉了",
+        "不滿意", "要退貨", "太扯了", "很失望", "超雷", "踩雷了",
+        "要退錢", "這什麼東西", "品質不行", "一直出問題", "根本不能用",
+        "很爛", "沒有想像中好", "落差很大"
+    ];
+
+    private static readonly string[] ProductPrefixes = ["TV-100", "MON-200", ""];
+
+    private static readonly string[] Openings =
+    [
+        "我買的 {0}", "我上週收到的 {0}", "我訂購的 {0}", "這台 {0}", "家裡新買的 {0}"
+    ];
+
+    private static readonly string[] GenericOpenings = ["我買的這台", "收到的商品", "上個月訂的這台", "這次收到的東西"];
+
+    private static readonly string[] Connectors = ["，而且", "，另外", "，還有", "。而且", "。另外", "，加上", "。除此之外"];
+
+    private static readonly string[] DemandSuffixes =
+    [
+        "希望能換貨。", "要求退款。", "請盡快處理。", "希望公司給個說法。",
+        "真的很失望，考慮以後不再回購。", "希望能有人主動聯絡說明。", "麻煩盡快回覆處理進度。"
+    ];
+
+    /// 同音誤植對照表：現場填單常見的錯別字，不是隨機亂碼。
+    private static readonly (string From, string To)[] Homophones =
+    [
+        ("的", "得"), ("在", "再"), ("面板", "面版")
+    ];
+
+    public IReadOnlyList<ComplaintRecord> Generate(int count = 1500)
+    {
+        var records = new List<ComplaintRecord>(count);
+
+        for (var i = 0; i < count; i++)
+        {
+            var labels = PickLabels();
+            var text = BuildText(labels);
+
+            // 標籤雜訊：人工標註漏標或多標一個分類
+            if (_random.NextDouble() < 0.05)
+            {
+                labels = ApplyLabelNoise(labels);
+            }
+
+            // 極短文本：文字本身沒資訊量，標籤是依電話備註另外判定的
+            if (_random.NextDouble() < 0.05)
+            {
+                var prefix = ProductPrefixes[_random.Next(ProductPrefixes.Length)];
+                var shortText = ShortTexts[_random.Next(ShortTexts.Length)];
+                text = string.IsNullOrEmpty(prefix) ? shortText : $"{prefix}，{shortText}";
+            }
+
+            records.Add(new ComplaintRecord($"CS-{i + 1:D5}", text, labels));
+        }
+
+        return records;
+    }
+
+    private List<string> PickLabels()
+    {
+        var primary = WeightedPick(_random, PrimaryWeights);
+        var labels = new List<string> { primary };
+
+        if (primary != LabelOther && _random.NextDouble() < 0.25)
+        {
+            var secondary = WeightedPick(_random, CoOccurrence[primary]);
+            if (!labels.Contains(secondary))
+            {
+                labels.Add(secondary);
+            }
+        }
+
+        if (labels.Count > 1 && _random.NextDouble() < 0.05)
+        {
+            var candidates = AllLabels.Where(l => l != LabelOther && !labels.Contains(l)).ToArray();
+            labels.Add(candidates[_random.Next(candidates.Length)]);
+        }
+
+        return labels;
+    }
+
+    /// 漏標或多標各佔一半：標籤數大於 1 時優先示範漏標，否則多標一個不存在的分類。
+    private List<string> ApplyLabelNoise(List<string> labels)
+    {
+        if (labels.Count > 1 && _random.NextDouble() < 0.5)
+        {
+            labels.RemoveAt(_random.Next(labels.Count));
+            return labels;
+        }
+
+        var candidates = AllLabels.Where(l => !labels.Contains(l)).ToArray();
+        if (candidates.Length > 0)
+        {
+            labels.Add(candidates[_random.Next(candidates.Length)]);
+        }
+
+        return labels;
+    }
+
+    private string BuildText(IReadOnlyList<string> labels)
+    {
+        var opening = BuildOpening(_random);
+        var sb = new System.Text.StringBuilder(opening);
+
+        for (var i = 0; i < labels.Count; i++)
+        {
+            var phrase = ApplyTypo(PickPhrase(labels[i], _random), _random);
+            sb.Append(i == 0 ? "，" : Connectors[_random.Next(Connectors.Length)]);
+            sb.Append(phrase);
+        }
+
+        // 通用細節句：與標籤無關的軸，純粹拉開文本組合空間，避免同標籤組合的樣本
+        // 只靠句式模板就能被模型記憶起來
+        if (_random.NextDouble() < 0.35)
+        {
+            sb.Append('，');
+            sb.Append(DetailClauses[_random.Next(DetailClauses.Length)]);
+        }
+
+        sb.Append('。');
+
+        if (_random.NextDouble() < 0.4)
+        {
+            sb.Append(DemandSuffixes[_random.Next(DemandSuffixes.Length)]);
+        }
+
+        return sb.ToString();
+    }
+
+    private static string BuildOpening(Random random)
+    {
+        var product = ProductPrefixes[random.Next(ProductPrefixes.Length)];
+        if (string.IsNullOrEmpty(product))
+        {
+            return GenericOpenings[random.Next(GenericOpenings.Length)];
+        }
+
+        var template = Openings[random.Next(Openings.Length)];
+        return string.Format(template, product);
+    }
+
+    private static string PickPhrase(string label, Random random)
+    {
+        var pool = PhraseBank[label];
+        return pool[random.Next(pool.Length)];
+    }
+
+    /// 錯別字/口語注入：疊字模擬輸入法連點，同音字替換模擬手誤。
+    /// 兩者互不排斥，同一句可能同時中兩種雜訊。
+    private static string ApplyTypo(string text, Random random)
+    {
+        if (random.NextDouble() < 0.12 && text.Length > 2)
+        {
+            var pos = random.Next(text.Length);
+            text = text.Insert(pos, text[pos].ToString());
+        }
+
+        foreach (var (from, to) in Homophones)
+        {
+            if (random.NextDouble() < 0.08 && text.Contains(from, StringComparison.Ordinal))
+            {
+                var index = text.IndexOf(from, StringComparison.Ordinal);
+                text = string.Concat(text.AsSpan(0, index), to, text.AsSpan(index + from.Length));
+                break;
+            }
+        }
+
+        return text;
+    }
+
+    private static string WeightedPick(Random random, (string Label, double Weight)[] pool)
+    {
+        var total = pool.Sum(p => p.Weight);
+        var roll = random.NextDouble() * total;
+        var cumulative = 0.0;
+
+        foreach (var (label, weight) in pool)
+        {
+            cumulative += weight;
+            if (roll < cumulative)
+            {
+                return label;
+            }
+        }
+
+        return pool[^1].Label;
+    }
+
+    /// 輸出成 CSV，labels 欄位用 `|` 分隔多標籤。文本裡若含逗號、引號或換行，
+    /// 依 CSV 慣例用雙引號包住並把內部雙引號跳脫成兩個雙引號。
+    public static string ToCsv(IReadOnlyList<ComplaintRecord> records)
+    {
+        var lines = new List<string>(records.Count + 1) { "text,labels" };
+
+        lines.AddRange(records.Select(r =>
+            string.Join(",", CsvField(r.Text), CsvField(string.Join("|", r.Labels)))));
+
+        return string.Join("\n", lines) + "\n";
+    }
+
+    private static string CsvField(string value)
+    {
+        if (value.IndexOfAny(['"', ',', '\n', '\r']) < 0)
+        {
+            return value;
+        }
+
+        return "\"" + value.Replace("\"", "\"\"") + "\"";
+    }
+}

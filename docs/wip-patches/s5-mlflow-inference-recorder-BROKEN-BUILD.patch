diff --git a/src/Erp.Infrastructure/Ml/BoundedInferenceInputRecorder.cs b/src/Erp.Infrastructure/Ml/BoundedInferenceInputRecorder.cs
new file mode 100644
index 0000000..fda073e
--- /dev/null
+++ b/src/Erp.Infrastructure/Ml/BoundedInferenceInputRecorder.cs
@@ -0,0 +1,65 @@
+using Erp.Application.Ml;
+
+namespace Erp.Infrastructure.Ml;
+
+/// <see cref="IInferenceInputRecorder"/> 的環狀緩衝區實作。
+///
+/// 容量 500：一個工單延遲風險查詢對應一次 Record，展示站的流量不可能
+/// 短時間衝到這個量，500 筆已經足夠讓離線 PSI 腳本算出一個不算太窄的樣本，
+/// 記憶體佔用（500 × 7 個 double，約 28KB）小到可以忽略。
+/// 這是刻意選的圓整數字，不是量測出來的最佳值 —— 真正有線上流量之後應該回頭調整。
+public sealed class BoundedInferenceInputRecorder : IInferenceInputRecorder
+{
+    private const int DefaultCapacity = 500;
+
+    private readonly WorkOrderDelayFeatures?[] _buffer;
+    private readonly Lock _lock = new();
+    private int _nextIndex;
+    private int _count;
+
+    public BoundedInferenceInputRecorder(int capacity = DefaultCapacity)
+    {
+        if (capacity <= 0)
+        {
+            throw new ArgumentOutOfRangeException(nameof(capacity), "容量必須是正整數");
+        }
+
+        Capacity = capacity;
+        _buffer = new WorkOrderDelayFeatures?[capacity];
+    }
+
+    public int Capacity { get; }
+
+    public void Record(WorkOrderDelayFeatures features)
+    {
+        lock (_lock)
+        {
+            _buffer[_nextIndex] = features;
+            _nextIndex = (_nextIndex + 1) % Capacity;
+            _count = Math.Min(_count + 1, Capacity);
+        }
+    }
+
+    public IReadOnlyList<WorkOrderDelayFeatures> Snapshot()
+    {
+        lock (_lock)
+        {
+            if (_count == 0)
+            {
+                return [];
+            }
+
+            // 緩衝區未寫滿時，資料從索引 0 開始連續排列；寫滿之後 _nextIndex
+            // 就是最舊那筆的位置（下一次要覆蓋的地方），依此還原「由舊到新」的順序。
+            var startIndex = _count < Capacity ? 0 : _nextIndex;
+            var result = new List<WorkOrderDelayFeatures>(_count);
+
+            for (var i = 0; i < _count; i++)
+            {
+                result.Add(_buffer[(startIndex + i) % Capacity]!);
+            }
+
+            return result;
+        }
+    }
+}

new file mode 100644
index 0000000..12a4e7f
--- /dev/null
+++ b/src/Erp.Application/Ml/IInferenceInputRecorder.cs
@@ -0,0 +1,27 @@
+namespace Erp.Application.Ml;
+
+/// 記錄線上推論時實際送進模型的特徵向量，給離線的漂移偵測腳本（PSI）當「近期分布」的來源。
+///
+/// **這是刻意取捨過的簡化版，不是完整的線上資料回流管線**：
+///
+/// 1. **只記憶體，不落地**：重啟就清空。理由是這個作品集規模的系統沒有正式的
+///    可觀測性基礎設施（沒有 ELK、沒有時序資料庫），加一個真正的落地機制
+///    （寫檔案或寫資料表）換到的可靠度，配不上它多出來的維運負擔 ——
+///    而且寫資料表屬於「未取得使用者同意不能做」的資料庫異動。
+/// 2. **固定容量的環狀緩衝區**：新資料進來時覆蓋最舊的一筆，不會無限長大，
+///    也不需要背景清理工作。容量的取捨見 <see cref="BoundedInferenceInputRecorder"/>。
+/// 3. **不拖慢推論**：Record 只做陣列賦值＋一個 lock，是 O(1) 操作。
+///
+/// 這個機制記的是「最近幾百筆」，不是「完整的線上分布」——樣本數不夠大時，
+/// PSI 的統計意義本身就有限，這是 PSI 演算法自己的侷限，不是這裡的侷限。
+public interface IInferenceInputRecorder
+{
+    /// 目前的環狀緩衝區容量
+    int Capacity { get; }
+
+    /// 記錄一次推論的輸入特徵
+    void Record(WorkOrderDelayFeatures features);
+
+    /// 目前緩衝區裡的所有輸入，由舊到新
+    IReadOnlyList<WorkOrderDelayFeatures> Snapshot();
+}

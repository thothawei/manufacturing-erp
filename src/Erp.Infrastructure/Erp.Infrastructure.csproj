  <!-- 模型檔與它的評估數據跟著組建輸出走。
       兩個都進 repo：clone 下來跑測試不需要 Python，也不需要重訓一次。 -->
  <ItemGroup>
    <None Update="Ml\work-order-delay-model.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Ml\work-order-delay-model.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
